# ===== 使用 OpenAI 兼容接口（下面哪家用哪个都行） =====
# OpenAI:        https://api.openai.com/v1
# DeepSeek:      https://api.deepseek.com/v1
# SiliconFlow:   https://api.siliconflow.cn/v1   （中文友好、便宜，推荐新手）
# 智谱 GLM:      https://open.bigmodel.cn/api/paas/v4

OPENAI_API_KEY=sk-把你的-key-填这里
OPENAI_BASE_URL=https://api.siliconflow.cn/v1

# 对话模型
LLM_MODEL=deepseek-ai/DeepSeek-V3

# Embedding 模型（向量化用）
# ⚠️ 一旦换了这个模型，向量维度会变，必须删除 chroma_db 目录后重新入库
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

# 向量库本地目录（相对路径以项目根目录为基准，不是启动目录）
CHROMA_DIR=./chroma_db

# 文档切分：每块最大字数 / 重叠字数（重叠必须小于每块字数）
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# 检索返回多少条（必须 >= 1）
TOP_K=4

# 单次模型请求超时（秒）。不设置的话会用 SDK 默认的 600 秒，界面看起来像卡死
REQUEST_TIMEOUT=60

# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# 单个问题最大字数
MAX_QUESTION_CHARS=2000
